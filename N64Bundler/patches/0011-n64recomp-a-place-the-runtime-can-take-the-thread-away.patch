+    // True when this branch closes a loop that cannot end on its own.
+    //
+    // Such a loop computes nothing that survives to the next iteration: every
+    // value it uses comes either from a register it never writes or from a word
+    // it loads, so the only thing that can change its outcome is another thread
+    // writing that word. On the console that is an interrupt, which preempts
+    // the thread and lets a higher-priority one run. A recompiled game has no
+    // interrupts: the runtime only gets to schedule when the game calls into
+    // it, and a loop like this never does, so the thread that would write the
+    // word never runs and the console model deadlocks. Yielding here is what
+    // the interrupt did.
+    //
+    // What separates one of these from an ordinary counting loop is a
+    // loop-carried register. `while (p != end) p++` reads `p` before it writes
+    // it, and what it reads is what the last iteration computed, so the loop
+    // moves on by itself and must not yield. A spin reads only registers it
+    // never writes, or ones a load filled from memory -- and a load carrying a
+    // value across is the whole point, since memory is where the answer comes
+    // from. So: walk one iteration, and reject the loop if a register it reads
+    // before defining is one that anything other than a load writes.
+    auto closes_a_spin_loop = [&instructions, instr_index, instr_vram](uint32_t branch_target) {
+        constexpr uint32_t kLongestSpin = 4 * sizeof(uint32_t);
+        if (branch_target >= instr_vram || instr_vram - branch_target > kLongestSpin) {
+            return false;
+        }
+        const size_t back = (instr_vram - branch_target) / sizeof(uint32_t);
+        if (back > instr_index || instr_index + 1 >= instructions.size()) {
+            return false;
+        }
+
+        // What one instruction reads and writes. A spin loop may hold only
+        // loads and register arithmetic; a store, a call, a second branch, a
+        // coprocessor access or a multiply and it is doing something else.
+        enum class Kind { None, Load, Compute };
+        struct Effect {
+            Kind kind;
+            int writes;
+            int reads[2];
+        };
+        auto effect_of = [](const rabbitizer::InstructionCpu &instr) -> Effect {
+            const int rd = (int)instr.GetO32_rd();
+            const int rs = (int)instr.GetO32_rs();
+            const int rt = (int)instr.GetO32_rt();
+            switch (instr.getUniqueId()) {
+                case InstrId::cpu_nop:
+                    return {Kind::Compute, 0, {0, 0}};
+                // A load's destination holds what memory held, so a use of it
+                // in the next iteration is a dependency on memory rather than
+                // on the loop's own arithmetic.
+                case InstrId::cpu_lb:  case InstrId::cpu_lbu:
+                case InstrId::cpu_lh:  case InstrId::cpu_lhu:
+                case InstrId::cpu_lw:  case InstrId::cpu_lwu:
+                    return {Kind::Load, rt, {rs, 0}};
+                case InstrId::cpu_add:  case InstrId::cpu_addu:
+                case InstrId::cpu_sub:  case InstrId::cpu_subu:
+                case InstrId::cpu_and:  case InstrId::cpu_or:
+                case InstrId::cpu_xor:  case InstrId::cpu_nor:
+                case InstrId::cpu_slt:  case InstrId::cpu_sltu:
+                case InstrId::cpu_sllv: case InstrId::cpu_srlv:
+                case InstrId::cpu_srav:
+                    return {Kind::Compute, rd, {rs, rt}};
+                case InstrId::cpu_sll: case InstrId::cpu_srl: case InstrId::cpu_sra:
+                    return {Kind::Compute, rd, {rt, 0}};
+                case InstrId::cpu_addi: case InstrId::cpu_addiu:
+                case InstrId::cpu_andi: case InstrId::cpu_ori:
+                case InstrId::cpu_xori: case InstrId::cpu_slti:
+                case InstrId::cpu_sltiu:
+                    return {Kind::Compute, rt, {rs, 0}};
+                case InstrId::cpu_lui:
+                    return {Kind::Compute, rt, {0, 0}};
+                default:
+                    return {Kind::None, 0, {0, 0}};
+            }
+        };
+
+        // One iteration in the order it runs: the body, the branch, then the
+        // branch's delay slot, whose result the next iteration sees.
+        std::vector<size_t> iteration;
+        for (size_t i = instr_index - back; i < instr_index; i++) {
+            iteration.push_back(i);
         }
+        iteration.push_back(instr_index);
+        iteration.push_back(instr_index + 1);
+
+        std::array<bool, 32> written{};
+        std::array<bool, 32> written_by_compute{};
+        for (size_t i : iteration) {
+            if (i == instr_index) {
+                continue; // the branch writes nothing
+            }
+            const Effect effect = effect_of(instructions[i]);
+            if (effect.kind == Kind::None) {
+                return false;
+            }
+            if (effect.writes == 0) {
+                continue; // $zero
+            }
+            written[effect.writes] = true;
+            if (effect.kind != Kind::Load) {
+                written_by_compute[effect.writes] = true;
+            }
+        }
+
+        std::array<bool, 32> defined{};
+        for (size_t i : iteration) {
+            const rabbitizer::InstructionCpu &instr = instructions[i];
+            // The branch's own operands count as reads; it is what the loop
+            // decides on. Over-reading here can only reject a loop, never
+            // yield in one that did not need it.
+            Effect effect = {Kind::Compute, 0,
+                             {(int)instr.GetO32_rs(), (int)instr.GetO32_rt()}};
+            if (i != instr_index) {
+                effect = effect_of(instr);
+            }
+            for (int source : effect.reads) {
+                if (source == 0 || !written[source] || defined[source]) {
+                    continue;
+                }
+                if (written_by_compute[source]) {
+                    return false;
+                }
+            }
+            if (i != instr_index && effect.writes != 0) {
+                defined[effect.writes] = true;
+            }
+        }
         return true;
     };
 
