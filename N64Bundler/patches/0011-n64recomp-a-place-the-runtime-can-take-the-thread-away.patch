+// A place the runtime is allowed to take the thread away.
+//
+// Only one recompiled thread runs at a time and the runtime chooses which, but
+// it only gets to choose when the running thread calls into it. On the console
+// that choice is made by an interrupt, at any instruction at all: a thread that
+// waits by reading memory in a loop is preempted, the thread that writes the
+// memory runs, and the wait ends. Here it never is, so a game that waits that
+// way waits forever -- and games do, for a sound to finish or a lock to clear.
+//
+// `spin_wait` below covers the smallest form of it, a loop the recompiler can
+// prove reads memory and does nothing else. This covers the rest: every
+// function entry is a point where the thread can be handed over, so any loop
+// that calls anything is interruptible. The cost when nothing is waiting is a
+// load of a word and a branch that is never taken.
+//
+// The status register goes with the call because a game that has turned
+// interrupts off has said, in the console's own terms, that this is not a
+// moment it may be interrupted at -- and the whole point of this is to be the
+// interrupt.
+extern volatile unsigned recomp_preempt_wanted;
+void recomp_preempt(uint8_t *rdram, unsigned status_reg);
+#define YIELD_POINT() if (recomp_preempt_wanted) { recomp_preempt(rdram, ctx->status_reg); }
+
 // The function signature for all recompiler output functions.
 typedef void (recomp_func_t)(uint8_t* rdram, recomp_context* ctx);
 // The function signature for special functions that need a third argument.
