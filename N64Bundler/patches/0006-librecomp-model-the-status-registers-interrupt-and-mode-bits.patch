diff --git a/librecomp/src/recomp.cpp b/librecomp/src/recomp.cpp
index 850689d..f3c3c1b 100644
--- a/librecomp/src/recomp.cpp
+++ b/librecomp/src/recomp.cpp
@@ -418,6 +418,34 @@ enum class StatusReg {
     FR = 0x04000000,
 };
 
+// IE and the eight interrupt mask bits -- the low half of libultra's
+// OS_IM_ALL, which is what a console running a game has in its status
+// register.
+//
+// This runtime has no interrupts to enable or mask, so nothing here ever
+// changes them: they are reported set, and a write to them is stored and
+// otherwise ignored, which is what `osSetIntMask` already does one level up.
+//
+// Reporting them matters because a game may read the mask to find out what the
+// console is doing rather than to change it. Banjo-Tooie's retrace thread
+// checks SR_IBIT5, the pre-NMI bit, on every frame -- libultra masks that one
+// off when the reset button is pressed, so a game that sees it clear knows it
+// is being reset, and Banjo-Tooie's answer is to stop the rumble motors, put
+// the video interface back to a plain mode and spin until the NMI arrives.
+// Read as zero, that fires on the first retrace and the game never draws
+// again.
+constexpr uint32_t status_interrupt_bits = 0x0000FF01;
+
+// The rest of what a game sets and this runtime has no machinery for: the two
+// exception level flags, and the four "coprocessor usable" bits. There are no
+// exceptions here, and every coprocessor a recompiled instruction uses is
+// always available -- so a game turning the floating point unit on at boot,
+// which is the common case, is asking for something that is already true.
+//
+// Stored and read back, so that a game which reads the register to find out
+// what it set gets the answer it set.
+constexpr uint32_t status_inert_bits = 0xF0000006;
+
 extern "C" void cop0_status_write(recomp_context* ctx, gpr value) {
     uint32_t old_sr = ctx->status_reg;
     uint32_t new_sr = (uint32_t)value;
@@ -442,11 +470,22 @@ extern "C" void cop0_status_write(recomp_context* ctx, gpr value) {
         changed &= ~(uint32_t)StatusReg::FR;
     }
 
-    // If any other bits were changed, assert false as they're not handled currently
+    // The interrupt and mode bits are modelled rather than handled: there is
+    // nothing here to mask or to fault, so a game setting them is stored and
+    // otherwise ignored. A game that reads the register, changes one bit and
+    // writes it back would otherwise arrive below with every bit this runtime
+    // reports set looking like a change it does not understand.
+    changed &= ~(status_interrupt_bits | status_inert_bits);
+
+    // Anything left is a bit nobody has reasoned about. Said once, and then
+    // the game carries on: taking a running game down over a status bit is
+    // the wrong trade, and which bit it was is the thing somebody needs.
     if (changed) {
-        printf("Unhandled status register bits changed: 0x%08X\n", changed);
-        assert(false);
-        exit(EXIT_FAILURE);
+        static bool reported = false;
+        if (!reported) {
+            reported = true;
+            printf("Unhandled status register bits changed: 0x%08X\n", changed);
+        }
     }
     
     // Update the status register in the context
@@ -454,7 +493,7 @@ extern "C" void cop0_status_write(recomp_context* ctx, gpr value) {
 }
 
 extern "C" gpr cop0_status_read(recomp_context* ctx) {
-    return (gpr)(int32_t)ctx->status_reg;
+    return (gpr)(int32_t)(ctx->status_reg | status_interrupt_bits);
 }
 
 extern "C" void switch_error(const char* func, uint32_t vram, uint32_t jtbl) {
