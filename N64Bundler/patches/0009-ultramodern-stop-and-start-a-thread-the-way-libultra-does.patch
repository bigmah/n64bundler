     OSThread* t = TO_PTR(OSThread, t_);
     debug_printf("[os] Start Thread %d\n", t->id);
 
-    // If this is a game thread, insert the new thread into the running queue and then check the running queue.
-    if (thread_self) {
-        ultramodern::schedule_running_thread(PASS_RDRAM t_);
-        ultramodern::check_running_queue(PASS_RDRAM1);
-    }
-    // Otherwise, immediately start the thread and terminate this one.
-    else {
+    // Nothing is scheduling yet: this is the entrypoint starting the game's
+    // first thread, so it just runs.
+    if (!thread_self) {
         t->state = OSThreadState::QUEUED;
         resume_thread(t);
         //throw ultramodern::thread_terminated{};
+        return;
     }
+
+    // Starting a thread only does anything to one that is stopped. libultra's
+    // own osStartThread is a switch on the thread's state and a thread that is
+    // already runnable or running falls out of it having done nothing -- which
+    // matters here rather than being a detail, because a thread is a node in
+    // the queue it is waiting on, so queuing an already-queued one makes a
+    // cycle and the next walk of that queue never returns.
+    if (t->state == OSThreadState::STOPPED) {
+        // Where it goes is where it was. A thread stopped while it was waiting
+        // on a message queue is put back on that queue rather than made
+        // runnable, because the message it was waiting for still has not
+        // arrived; `queue` names that queue because stopping it left the name
+        // behind on purpose. A thread that was runnable, or one that has never
+        // run at all, becomes runnable.
+        if (t->queue == NULLPTR || t->queue == ultramodern::running_queue) {
+            ultramodern::schedule_running_thread(PASS_RDRAM t_);
+        }
+        else {
+            ultramodern::thread_queue_insert(PASS_RDRAM t->queue, t_);
+            t->state = OSThreadState::BLOCKED;
+        }
+    }
+
+    ultramodern::check_running_queue(PASS_RDRAM1);
 }
 
