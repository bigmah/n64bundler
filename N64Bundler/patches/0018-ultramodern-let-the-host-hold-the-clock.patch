 static PTR(OSThread) running_queue_impl = NULLPTR;
 
+/// The priority of the thread at the head of the running queue, or nothing.
+///
+/// Kept as a number beside the queue because the one thing that has to ask
+/// about it -- whether the console has finished a frame, from a thread that is
+/// not the game's -- cannot walk a list in the game's memory while the game is
+/// walking it. The queue is only ever changed from a game thread, and every
+/// such change comes through this file.
+static std::atomic<int> runnable_top{INT_MIN};
+
+static void note_running_queue(RDRAM_ARG1) {
+    runnable_top.store(running_queue_impl == NULLPTR
+                           ? INT_MIN
+                           : TO_PTR(OSThread, running_queue_impl)->priority,
+                       std::memory_order_relaxed);
+}
+
+/// Whether a thread the scheduler is holding would take the processor from one
+/// running at `priority`.
+///
+/// This is the question, rather than "is anything runnable at all". A thread
+/// waiting at a lower priority than the one that is running is not work
+/// outstanding: it is a thread that will not run until the one above it stops,
+/// and the idle thread of every game spends its whole life in exactly that
+/// position -- queued, at priority zero, behind whichever thread swapped away
+/// from it. Treating that as an unfinished frame means every frame is
+/// unfinished.
+bool ultramodern::runnable_above(int priority) {
+    return runnable_top.load(std::memory_order_relaxed) > priority;
+}
+
+/// Whether the scheduler is holding a thread that ought to be running.
+///
+/// The running queue is the one queue that is not in the game's memory, so
+/// asking about it is the one question about the scheduler that can be asked
+/// without rdram -- which is what something outside the game has to do to find
+/// out whether the console is between frames or in the middle of one. A thread
+/// waiting here is a frame that is not finished, however quiet the rest of it
+/// looks: see `nothing_left_to_do` in mesgqueue.cpp.
+bool ultramodern::threads_waiting_to_run() {
+    return running_queue_impl != NULLPTR;
+}
+
+/// Who they are, for when nothing is running and somebody is waiting to.
+void ultramodern::describe_running_queue(RDRAM_ARG char* out, size_t size) {
+    int written = std::snprintf(out, size, "runnable:");
+    PTR(OSThread) cur = running_queue_impl;
+    if (cur == NULLPTR) {
+        std::snprintf(out + written, size - size_t(written), " nobody");
+        return;
+    }
+    while (cur != NULLPTR && size_t(written) < size) {
+        OSThread* thread = TO_PTR(OSThread, cur);
+        written += std::snprintf(out + written, size - size_t(written), " thread %d (priority %d, state %d)",
+                                 thread->id, thread->priority, (int)thread->state);
+        cur = thread->next;
+    }
+}
