+// --- the video interface, put down and picked up again -----------------------
+//
+// See `ViSnapshot` in ultramodern.hpp for why this is not in the console's
+// memory and why a savestate has to carry it anyway. The only translation on
+// the way through is `mode`, which is kept in here as a pointer into this
+// process's copy of the console's memory and has to leave as an address in it.
+
+void ultramodern::save_vi(RDRAM_ARG ViSnapshot* out) {
+    std::lock_guard lock{ events_context.message_mutex };
+    for (int i = 0; i < 2; i++) {
+        const ::ViState& from = events_context.vi.states[i];
+        ViSnapshot::State& to = out->states[i];
+        to.mode = from.mode == nullptr
+                      ? PTR(OSViMode)(NULLPTR)
+                      : PTR(OSViMode)(0x80000000u + uint32_t(reinterpret_cast<const uint8_t*>(from.mode) - rdram));
+        to.framebuffer = from.framebuffer;
+        to.mq = from.mq;
+        to.msg = from.msg;
+        to.state = from.state;
+        to.control = from.control;
+        to.retrace_count = from.retrace_count;
+    }
+    out->regs = events_context.vi.regs;
+    out->cur_state = events_context.vi.cur_state;
+    out->field = events_context.vi.field;
+    out->remaining_retraces = remaining_retraces;
+}
+
+void ultramodern::load_vi(RDRAM_ARG const ViSnapshot* in) {
+    std::lock_guard lock{ events_context.message_mutex };
+    for (int i = 0; i < 2; i++) {
+        const ViSnapshot::State& from = in->states[i];
+        ::ViState& to = events_context.vi.states[i];
+        to.mode = from.mode == NULLPTR ? nullptr : TO_PTR(OSViMode, from.mode);
+        to.framebuffer = from.framebuffer;
+        to.mq = from.mq;
+        to.msg = from.msg;
+        to.state = from.state;
+        to.control = from.control;
+        to.retrace_count = from.retrace_count;
+    }
+    events_context.vi.regs = in->regs;
+    events_context.vi.cur_state = in->cur_state;
+    events_context.vi.field = in->field;
+    remaining_retraces = in->remaining_retraces;
+}
