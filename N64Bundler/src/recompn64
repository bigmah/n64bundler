#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# recompn64 - turn an N64 ROM into a game you can play from the library.
#
#   1. read the header, normalise the byte order, work out what this is
#   2. recover the metadata a decompilation would have supplied (n64rip)
#   3. statically recompile the MIPS to native arm64 (n64b-port)
#   4. add it to the library, and optionally build a .app
#
# Usage: recompn64 [--porcelain] [--app] [--no-open] [--force]
#                  <rom.z64|.n64|.v64> [more roms...]
#        recompn64 play     --game-id <id> --rom <rom> --module <lib> --title <s>
#                           [--fullscreen]
#        recompn64 make-app --game-id <id> --rom <rom> --module <lib> --title <s>
#        recompn64 inspect  <rom>
#
# By default a ROM is analysed, recompiled and added to the library; it is
# played from N64Bundler's list. --app additionally builds a .app in
# ~/Applications. `play` and `make-app` are what the window calls for a ROM
# that has already been recompiled.
#
# No game data is written anywhere but the runtime's own copy of the ROM. The
# analysis and the module are addresses and translated instructions; the .app
# is a launcher holding paths.
#
# --porcelain adds machine-readable event lines for the GUI and drops the
# colour codes. Everything else on stdout is log text. The events are:
#
#   @@step <index> <total> <title>
#   @@info <key>=<value>     key in: rom game_id name module analysis app
#                                    functions coverage cached save_type
#   @@ok
#   @@fail <message>
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$SELF_DIR/toolchain.conf"

MODE=pipeline
case "${1-}" in
  play|make-app|inspect) MODE="$1"; shift ;;
esac

PORCELAIN=0
AUTO_OPEN=1
MAKE_APP=0
FORCE=0
FULLSCREEN=0
ROMS=()
ARG_GAME_ID=''; ARG_ROM=''; ARG_MODULE=''; ARG_TITLE=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --porcelain)  PORCELAIN=1; AUTO_OPEN=0 ;;
    --app)        MAKE_APP=1 ;;
    --no-open)    AUTO_OPEN=0 ;;
    --open)       AUTO_OPEN=1 ;;
    --force)      FORCE=1 ;;
    --fullscreen) FULLSCREEN=1 ;;
    --game-id)    ARG_GAME_ID="${2-}"; shift ;;
    --rom)        ARG_ROM="${2-}"; shift ;;
    --module)     ARG_MODULE="${2-}"; shift ;;
    --title)      ARG_TITLE="${2-}"; shift ;;
    -*)           echo "unknown option: $1" >&2; exit 2 ;;
    *)            ROMS+=("$1") ;;
  esac
  shift
done

if [ "$PORCELAIN" -eq 1 ]; then
  bold=''; dim=''; red=''; green=''; off=''
else
  bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; green=$'\033[32m'; off=$'\033[0m'
fi

emit() { [ "$PORCELAIN" -eq 1 ] && printf '@@%s\n' "$*"; return 0; }
# In porcelain mode the window renders its own heading from the event, so the
# human-readable copy would show up twice.
step() { emit "step $1 $2 $3"
         [ "$PORCELAIN" -eq 1 ] && return 0
         printf '\n%s==> %s/%s  %s%s\n' "$bold" "$1" "$2" "$3" "$off"; }
info() { emit "info $1=$2"; }
note() { printf '%s    %s%s\n' "$dim" "$*" "$off"; }
ok()   { printf '%s    %s%s\n' "$green" "$*" "$off"; }
die()  { emit "fail $*"; printf '\n%serror: %s%s\n' "$red" "$*" "$off" >&2; exit 1; }

[ -f "$CONF" ] || die "missing $CONF; re-run N64Bundler/build.sh"
# shellcheck source=/dev/null
source "$CONF"

# A window launched from Finder inherits launchd's PATH - /usr/bin:/bin and the
# two sbins - so Homebrew's clang wrappers and friends are invisible exactly
# when the app is how you started this, and only then.
[ -n "${TOOLCHAIN_PATH-}" ] && export PATH="$TOOLCHAIN_PATH:$PATH"

: "${MR_BUILD:?toolchain.conf did not set MR_BUILD}"
: "${APPS_DIR:=$HOME/Applications}"
: "${RUNTIME_PROVIDES:=}"
: "${SIGNATURES:=}"
: "${TITLES_DIR:=}"

SUPPORT_DIR="$HOME/Library/Application Support/N64Bundler"
LIBRARY="$SUPPORT_DIR/library.json"
COVERS="$SUPPORT_DIR/covers"
GAMES="$SUPPORT_DIR/games"
LOGS="$SUPPORT_DIR/logs"

for tool in n64rip n64b-port; do
  [ -x "$MR_BUILD/$tool" ] || die "$MR_BUILD/$tool is missing; re-run N64Bundler/build.sh"
done
[ -x "$MR_BUILD/host/n64b-run" ] || die "$MR_BUILD/host/n64b-run is missing; re-run N64Bundler/build.sh"

# --- subcommands -------------------------------------------------------------
# Both act on a ROM that is already recompiled, so neither needs a compiler.

require_fields() {
  [ -n "$ARG_GAME_ID" ] || die "$1 needs --game-id"
  [ -n "$ARG_ROM" ]     || die "$1 needs --rom"
  [ -n "$ARG_MODULE" ]  || die "$1 needs --module"
  [ -n "$ARG_TITLE" ]   || die "$1 needs --title"
  [ -f "$ARG_ROM" ]     || die "the ROM is missing from $ARG_ROM"
  [ -f "$ARG_MODULE" ]  || die "the recompiled module is missing from $ARG_MODULE; add the ROM again to rebuild it"
}

register_game() {
  /usr/bin/python3 "$SELF_DIR/make_game_app.py" \
    --name "$ARG_TITLE" --game-id "$ARG_GAME_ID" --rom "$ARG_ROM" \
    --module "$ARG_MODULE" --runtime "$MR_BUILD/host" \
    --library "$LIBRARY" --covers "$COVERS" "$@"
}

if [ "$MODE" = inspect ]; then
  [ "${#ROMS[@]}" -gt 0 ] || die "inspect needs a ROM"
  exec "$MR_BUILD/n64rip" inspect "${ROMS[0]}"
fi

if [ "$MODE" = play ]; then
  require_fields play
  mkdir -p "$LOGS"
  fullscreen_args=()
  [ "$FULLSCREEN" -eq 1 ] && fullscreen_args=(--fullscreen)
  # Mirrors the generated .app's launcher. The bundle keeps its own copy on
  # purpose: it has to run with N64Bundler uninstalled.
  # macOS ships bash 3.2, where "${arr[@]}" on an *empty* array trips `set -u`
  # with "unbound variable"; ${arr[@]+...} expands to nothing instead.
  exec "$MR_BUILD/host/n64b-run" \
    --module "$ARG_MODULE" \
    --rom "$ARG_ROM" \
    "${fullscreen_args[@]+"${fullscreen_args[@]}"}" \
    >>"$LOGS/$ARG_GAME_ID.log" 2>&1
fi

if [ "$MODE" = make-app ]; then
  require_fields make-app
  mkdir -p "$APPS_DIR"
  app="$(register_game --app --out-dir "$APPS_DIR")" || die "could not build the app bundle"
  info app "$app"
  ok "$app"
  exit 0
fi

# --- the pipeline ------------------------------------------------------------

process_one() {
  local rom="$1"
  [ -f "$rom" ] || die "no such file: $rom"
  # The library entry and the .app launcher hold this path and are read later,
  # from a working directory nobody controls -- a Finder launch starts in "/".
  # A ROM named on the command line as "sm64.z64" has to be written down as
  # where it actually is.
  rom="$(cd "$(dirname "$rom")" && pwd)/$(basename "$rom")"
  info rom "$rom"

  printf '%s%s%s\n' "$bold" "RecompN64 - $(basename "$rom")" "$off"

  step 1 4 "Reading the ROM"
  local header
  header="$("$MR_BUILD/n64rip" inspect "$rom")" \
    || die "that file is not an N64 ROM. A cartridge dump is 4MB or more and starts with 0x80371240 in one of three byte orders."
  printf '%s\n' "$header" | sed 's/^/    /'
  local game_id
  game_id="$(sed -n 's/^Game ID: *//p' <<<"$header")"
  [ -n "$game_id" ] || die "the ROM header carried no game ID"
  info game_id "$game_id"

  local analysis="$GAMES/$game_id/analysis"
  local module="$GAMES/$game_id/$game_id.dylib"
  mkdir -p "$analysis" "$GAMES/$game_id"

  # Console memory, after the game's own loader has run. Only a cartridge that
  # holds its game compressed needs one, and only such a cartridge's title
  # record asks for it. It sits beside the module rather than in the source
  # tree: it is a derived work of the player's own dump, exactly as the
  # library's copy of the ROM is.
  local image="$GAMES/$game_id/$game_id.ram.bin"
  # The ROM the recompiler reads. The same file as the player's, unless the
  # analysis had to normalise the byte order or splice an unpacked segment on
  # the end -- in either case n64rip writes the one it means.
  local recomp_rom="$analysis/$game_id.z64"

  run_rip() {
    local rip_args=(analyze "$rom" --out-dir "$analysis")
    [ -n "$RUNTIME_PROVIDES" ] && [ -f "$RUNTIME_PROVIDES" ] && rip_args+=(--runtime-provides "$RUNTIME_PROVIDES")
    [ -n "$SIGNATURES" ] && [ -f "$SIGNATURES" ] && rip_args+=(--signatures "$SIGNATURES")
    [ -n "$TITLES_DIR" ] && [ -d "$TITLES_DIR" ] && rip_args+=(--titles "$TITLES_DIR")
    [ -f "$image" ] && rip_args+=(--unpacked "$image")
    "$MR_BUILD/n64rip" "${rip_args[@]}" 2>&1 | tee "$1"
    return "${PIPESTATUS[0]}"
  }

  run_port() {
    local port_args=(build --analysis "$analysis" --out "$module")
    if [ -f "$recomp_rom" ]; then
      port_args+=(--rom "$recomp_rom")
    else
      port_args+=(--rom "$rom")
    fi
    [ "$FORCE" -eq 1 ] && port_args+=(--force)
    "$MR_BUILD/n64b-port" "${port_args[@]}" 2>&1 | tee "$1"
    return "${PIPESTATUS[0]}"
  }

  step 2 4 "Recovering the metadata from the image"
  note "An N64 ROM carries no section table and no symbols, so where the code is and where each function starts has to be worked out from the instructions."
  local rip_log; rip_log="$(mktemp -t recompn64-rip)"
  run_rip "$rip_log" || { rm -f "$rip_log"; die "nothing could be recovered from this ROM"; }

  # A cartridge that holds its game compressed has to be run before it can be
  # read, and read again before it can be run further.
  #
  # Its record names segments that are in no part of the image -- until the
  # game's own loader has unpacked them, the code does not exist anywhere. So
  # what is recovered so far is recompiled, run, and stopped at the moment it
  # jumps into something that was not; `--unpack` writes console memory out at
  # that point, and the analysis is done again with it.
  #
  # That is a loop rather than a step, because a game unpacks in stages and
  # each stage only appears once the one before it is running. Banjo-Tooie
  # takes two rounds: the loader reveals the core, and the core reveals the
  # main segment. It ends when every segment the record names has come out of
  # the image as code, which is what the analysis reports.
  unpacked_state() {
    sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" "$analysis/$game_id.info.json" 2>/dev/null | head -1
  }
  local wanted recovered round
  wanted="$(unpacked_state unpacked_segments)"
  if [ "${wanted:-0}" -gt 0 ]; then
    round=0
    while :; do
      recovered="$(unpacked_state unpacked_recovered)"
      [ "${recovered:-0}" -ge "$wanted" ] && break
      round=$((round + 1))
      # One round per stage, and a cartridge with more stages than this is one
      # nobody here has seen; stopping is better than looping on a game that
      # never settles.
      [ "$round" -gt 6 ] && { rm -f "$rip_log"
        die "this game unpacks more stages than the pipeline will follow (stopped after $((round - 1)))"; }
      note "This cartridge holds its game compressed: $recovered of $wanted segments are readable so far. Recompiling what there is and running it to find the next."
      local boot_log; boot_log="$(mktemp -t recompn64-boot)"
      run_port "$boot_log" >/dev/null 2>&1 || { rm -f "$boot_log" "$rip_log"
        die "what has been recovered so far could not be recompiled, so the game could not be unpacked"; }
      rm -f "$boot_log"
      "$MR_BUILD/host/n64b-run" --module "$module" --rom "$rom" --unpack "$image" \
        >/dev/null 2>&1
      [ -f "$image" ] || { rm -f "$rip_log"
        die "the game did not reach anything it had unpacked, so nothing was written to $image"; }
      note "Reading the metadata again, with what it put in memory."
      run_rip "$rip_log" || { rm -f "$rip_log"; die "nothing could be recovered from this ROM"; }
    done
  fi

  local name functions coverage save_type
  name="$(sed -n 's/^Title: *//p' "$rip_log")"
  functions="$(sed -n 's/^\([0-9]*\) functions recovered.*/\1/p' "$rip_log" | head -1)"
  coverage="$(sed -n 's/.*internal calls land on a function boundary (\(.*\)%).*/\1/p' "$rip_log" | head -1)"
  save_type="$(sed -n 's/^Save type: *\([a-z_]*\).*/\1/p' "$rip_log" | head -1)"
  rm -f "$rip_log"
  [ -n "$name" ] || name="$game_id"
  name="${name//\//-}"; name="${name//:/-}"
  info name "$name"
  info functions "${functions:-0}"
  info coverage "${coverage:-0}"
  info save_type "${save_type:-allow_all}"

  step 3 4 "Recompiling $name to native arm64"
  note "MIPS to C to machine code. The first pass takes a few seconds a megabyte; later ones are cached on the ROM's hash."
  local port_log; port_log="$(mktemp -t recompn64-port)"
  run_port "$port_log" || { rm -f "$port_log"; die "the recompilation failed (see the log above)"; }
  # n64b-port speaks the same porcelain protocol, but it is deliberately not
  # asked for it here: its step counter would collide with this one in the
  # window. Its English output is the one parse path.
  local cached; cached="$(sed -n 's/^ *cached: //p' "$port_log" | tail -1)"
  rm -f "$port_log"
  [ -f "$module" ] || die "the recompiler did not produce a module"
  info module "$module"
  info cached "${cached:-0}"
  ok "$(du -h "$module" | cut -f1 | tr -d ' ') native module"

  # register_game reads these; the pipeline and the subcommands share one path
  # into make_game_app.py.
  ARG_TITLE="$name"; ARG_GAME_ID="$game_id"; ARG_ROM="$rom"; ARG_MODULE="$module"

  local app=""
  if [ "$MAKE_APP" -eq 1 ]; then
    step 4 4 "Building $name.app"
    mkdir -p "$APPS_DIR"
    app="$(register_game --app --out-dir "$APPS_DIR")" || die "could not build the app bundle"
    info app "$app"
    ok "$app"
  else
    step 4 4 "Adding $name to the library"
    register_game >/dev/null || die "could not add the game to the library"
    ok "in the library - play it from N64Bundler"
  fi

  printf '\n%s%s is ready.%s %s(%s, %s functions, %s%% of its calls placed)%s\n' \
    "$green" "$name" "$off" "$dim" "$game_id" "${functions:-0}" "${coverage:-0}" "$off"
  if [ -n "$app" ] && [ "$AUTO_OPEN" -eq 1 ]; then
    printf '%sOpening it now. It also lives in %s.%s\n' "$dim" "$APPS_DIR" "$off"
    open "$app"
  elif [ -z "$app" ]; then
    printf '%sPlay it from N64Bundler, or add --app to build a .app in %s.%s\n' \
      "$dim" "$APPS_DIR" "$off"
  fi
  emit ok
}

if [ "${#ROMS[@]}" -eq 0 ]; then
  echo "usage: $(basename "$0") [--porcelain] [--app] [--no-open] <rom.z64> [...]" >&2
  exit 2
fi

for rom in "${ROMS[@]}"; do
  process_one "$rom"
done
