+// --- when the console has nothing left to do ---------------------------------
+//
+// A thread that waits here is waiting for the hardware, and it is the last one:
+// every other thread of the game is on a message queue, and whichever of them
+// should be running next would be running instead of this. So a game parked
+// here with nothing on its way to it is a game that has finished everything the
+// last interrupt gave it to do -- which is the question something driving the
+// console a frame at a time has to be able to ask, and the only honest answer to
+// it. A frame is not over when the picture was handed over; it is over when
+// nothing is left.
+//
+// Three things have to be true at once, and they are checked rather than waited
+// out. Nobody is running: a thread is parked here, and no thread the scheduler
+// has made runnable is waiting its turn. Nothing has been said that has not been
+// heard: the queue below is empty. And no device is still working: every task
+// handed to the signal processor has been answered, which is what
+// `hardware_work_started` and `hardware_work_finished` count, because the
+// message that ends one of those arrives long after the game asked for it.
+//
+// The epoch is what makes this usable without a race. It counts the times the
+// game has gone quiet, so a caller reads it, pokes the console, and waits for a
+// number above the one it read: quiet about the frame before is not quiet about
+// this one.
+namespace {
+std::mutex quiet_mutex;
+std::condition_variable quiet_changed;
+bool parked_for_hardware = false;
+int hardware_in_flight = 0;
+uint64_t quiet_epoch = 0;
+
+/// Which thread is parked, and what it would be preempted by. A thread waiting
+/// for the hardware is the running one as far as the game is concerned, so what
+/// counts as work outstanding is measured against its priority.
+PTR(OSThread) parked_thread = NULLPTR;
+int parked_priority = INT_MIN;
+
+bool nothing_left_to_do() {
+    return parked_for_hardware && hardware_in_flight == 0 &&
+           external_messages.size_approx() == 0 && !ultramodern::runnable_above(parked_priority);
+}
+
+void park_for_hardware(RDRAM_ARG1) {
+    const PTR(OSThread) self = ultramodern::this_thread();
+    const int priority = self == NULLPTR ? INT_MIN : TO_PTR(OSThread, self)->priority;
+    std::lock_guard lock{ quiet_mutex };
+    parked_for_hardware = true;
+    parked_thread = self;
+    parked_priority = priority;
+    quiet_epoch++;
+    quiet_changed.notify_all();
+}
+
+void unpark_from_hardware() {
+    std::lock_guard lock{ quiet_mutex };
+    parked_for_hardware = false;
+}
+} // namespace
+
+void ultramodern::hardware_work_started() {
+    std::lock_guard lock{ quiet_mutex };
+    hardware_in_flight++;
+}
+
+void ultramodern::hardware_work_finished() {
+    std::lock_guard lock{ quiet_mutex };
+    hardware_in_flight--;
+    quiet_changed.notify_all();
+}
+
+uint64_t ultramodern::quiescent_epoch() {
+    std::lock_guard lock{ quiet_mutex };
+    return quiet_epoch;
+}
+
+void ultramodern::describe_quiescence(RDRAM_ARG char* out, size_t size) {
+    char runnable[192];
+    ultramodern::describe_running_queue(PASS_RDRAM runnable, sizeof(runnable));
+    std::lock_guard lock{ quiet_mutex };
+    std::snprintf(out, size,
+                  "thread %d is %s at priority %d, %d task(s) outstanding, %zu message(s) undelivered, %s",
+                  parked_thread == NULLPTR ? -1 : TO_PTR(OSThread, parked_thread)->id,
+                  parked_for_hardware ? "parked" : "running", parked_priority, hardware_in_flight,
+                  external_messages.size_approx(), runnable);
+}
+
+bool ultramodern::hardware_busy() {
+    std::lock_guard lock{ quiet_mutex };
+    return hardware_in_flight > 0;
+}
+
+bool ultramodern::is_quiescent() {
+    std::lock_guard lock{ quiet_mutex };
+    return nothing_left_to_do();
+}
+
+bool ultramodern::wait_until_quiescent(uint64_t epoch, uint32_t timeout_ms) {
+    std::unique_lock lock{ quiet_mutex };
+    return quiet_changed.wait_for(lock, std::chrono::milliseconds{ timeout_ms },
+                                  [epoch]() { return quiet_epoch > epoch && nothing_left_to_do(); });
+}
