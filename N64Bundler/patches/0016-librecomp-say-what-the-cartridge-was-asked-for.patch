+/// What the cartridge was asked for, and when.
+///
+/// A transfer here costs nothing: the bytes are already in a host buffer and
+/// the copy is a memcpy. On the console it costs the time the parallel
+/// interface takes to clock them out, and a game that loads a world waits for
+/// exactly that. Whether that is where the console's loading pauses go is a
+/// question about this game rather than about the runtime, so the runtime can
+/// answer it: `N64B_PI_LOG` reports every transfer, and the running total
+/// against the wall clock says how many bytes a pause is made of.
+static void report_dma(uint32_t physical_addr, uint32_t size, uint32_t direction) {
+    static const bool wanted = std::getenv("N64B_PI_LOG") != nullptr;
+    if (!wanted) {
+        return;
     }
+    using namespace std::chrono;
+    static const auto started = steady_clock::now();
+    static uint64_t total = 0;
+    static uint64_t transfers = 0;
+    total += size;
+    transfers++;
+    const double at = duration<double>(steady_clock::now() - started).count();
+    std::fprintf(stderr, "pi: %8.3fs %s 0x%08X %7u bytes (%llu transfers, %.2f MB total)\n",
+                 at, direction == 0 ? "read " : "write", physical_addr, size,
+                 (unsigned long long)transfers, double(total) / (1024.0 * 1024.0));
 }
 
