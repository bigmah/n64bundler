+// --- what the video interface is set to, to something outside the game -------
+//
+// The same problem as the registers above, for the same reason. A game tells
+// the video interface what to do once and then forgets: which mode it is in,
+// which framebuffer it is scanning, whether the picture is blanked. libultra
+// kept that in the VI manager rather than in the game's own memory, so this
+// keeps it here -- which means none of it is in a memory image, and a game put
+// back from one has no way to say it again. It made those calls in a process
+// that is gone.
+//
+// For `osViBlack` that is the whole picture. Every game blanks the screen while
+// it boots and unblanks it when it first has something to show, so a state
+// taken in a level and restored into a console still booting resumes a game
+// that runs, plays its music and moves -- behind a raster that was switched off
+// before the state began and is never switched on again. The window stays
+// black, and nothing about the game is wrong.
+//
+// So the interface travels with the memory. This is that state in the shape a
+// caller can write to a file: `mode` is an address in the console's memory
+// rather than a pointer into this process's copy of it, and everything else is
+// as it is kept.
+struct ViSnapshot {
+    struct State {
+        PTR(OSViMode) mode; // NULLPTR when the game has not set one yet
+        PTR(void) framebuffer;
+        PTR(OSMesg) mq;
+        OSMesg msg;
+        uint32_t state;
+        uint32_t control;
+        int32_t retrace_count;
+    } states[2];
+    ultramodern::renderer::ViRegs regs;
+    int32_t cur_state;
+    int32_t field;
+    int32_t remaining_retraces;
+};
 
+void save_vi(RDRAM_ARG ViSnapshot* out);
+void load_vi(RDRAM_ARG const ViSnapshot* in);
+
