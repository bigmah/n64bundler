+/// Take a thread out of a queue it is somewhere in the middle of.
+///
+/// The pointer walked is the address of each `next` field rather than the
+/// thread it holds, so that unlinking is one store whichever position the
+/// thread is in -- including the head, which for the running queue is not in
+/// the game's memory at all.
+///
+/// `queue` is deliberately left pointing at the queue the thread came out of.
+/// That is what libultra does and what `osStartThread` reads: a thread stopped
+/// while it was waiting on a message queue goes back onto that queue when it is
+/// started again, rather than becoming runnable.
 bool ultramodern::thread_queue_remove(RDRAM_ARG PTR(PTR(OSThread)) queue_, PTR(OSThread) t_) {
+    if (queue_ == NULLPTR || t_ == NULLPTR) {
+        return false;
+    }
     debug_printf("[Thread Queue] Removing thread %d from queue 0x%08X\n", TO_PTR(OSThread, t_)->id, (uintptr_t)queue_);
 
-    PTR(PTR(OSThread)) cur = queue_;
-    while (cur != NULLPTR) {
-        PTR(OSThread)* cur_ptr = queue_to_ptr(PASS_RDRAM queue_);
-        if (*cur_ptr == t_) {
-            *cur_ptr = TO_PTR(OSThread, *cur_ptr)->next;
+    PTR(OSThread)* cur = queue_to_ptr(PASS_RDRAM queue_);
+    while (*cur != NULLPTR) {
+        if (*cur == t_) {
+            *cur = TO_PTR(OSThread, t_)->next;
+            TO_PTR(OSThread, t_)->next = NULLPTR;
             return true;
         }
-        cur = TO_PTR(OSThread, *cur_ptr)->next;
+        cur = &TO_PTR(OSThread, *cur)->next;
     }
 
     return false;
diff --git a/ultramodern/src/threads.cpp b/ultramodern/src/threads.cpp
